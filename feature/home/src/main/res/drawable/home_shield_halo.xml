<!-- Soft glow behind the shield: lime while protecting, red while off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#14CCF66B" />
                </shape>
            </item>
            <item
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp">
                <shape android:shape="oval">
                    <solid android:color="#24CCF66B" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#1AFF5A4F" />
                </shape>
            </item>
            <item
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp">
                <shape android:shape="oval">
                    <solid android:color="#2EFF5A4F" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
